# Drizzle
DATABASE_URL="mysql://root:mysecretpassword@localhost:3306/local"

ORIGIN="http://localhost:5173"
# For PayMongo (GCash / QR Ph) local testing, set ORIGIN to your public tunnel URL instead,
# e.g. ORIGIN="https://abc.ngrok-free.app", browse the app via that URL, and register
# https://abc.ngrok-free.app/api/paymongo/webhook in the PayMongo dashboard.

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta / Facebook Login (https://developers.facebook.com/apps)
# Redirect URI: {ORIGIN}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Lichess OAuth (https://lichess.org/account/oauth/app)
LICHESS_CLIENT_ID=""

# PayMongo (GCash / QR Ph entry fees and GCash prize disbursements)
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Required for prize payouts. Enable and fund PayMongo Wallet/Disbursements first.
PAYMONGO_WALLET_ACCOUNT_NUMBER=""
PAYMONGO_WALLET_ACCOUNT_NAME=""
