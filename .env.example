# Drizzle
DATABASE_URL="mysql://root:mysecretpassword@localhost:3306/local"

ORIGIN="http://localhost:5173"
# For PayMongo (GCash / QR Ph) local testing, set ORIGIN to your public tunnel URL instead,
# e.g. ORIGIN="https://abc.ngrok-free.app", browse the app via that URL, and register
# https://abc.ngrok-free.app/api/paymongo/webhook in the PayMongo dashboard.

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google login via Better Auth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {ORIGIN}/api/auth/callback/google
# Also add {ORIGIN} under Authorized JavaScript origins for the official GIS button
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps (OTB venue pin + public map). Browser key — restrict by HTTP referrer.
# Enable: Maps JavaScript API, Places API, Geocoding API
# https://console.cloud.google.com/google/maps-apis
PUBLIC_GOOGLE_MAPS_API_KEY=""

# Meta / Facebook Login — postponed (not wired into Better Auth)
# When re-enabled: Valid OAuth Redirect URI {ORIGIN}/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Lichess chess-account linking — not ChessHub app login (https://lichess.org/account/oauth/app)
LICHESS_CLIENT_ID=""

# Chess.com chess-account linking — not ChessHub app login
# Apply: https://www.chess.com/announcements/view/chess-com-oauth-login-application
# Redirect URI: {ORIGIN}/api/chess/chesscom/callback
CHESSCOM_CLIENT_ID=""
CHESSCOM_CLIENT_SECRET=""

# Protects /api/cron/refresh-ratings (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# PayMongo (GCash / QR Ph entry fees and GCash prize disbursements)
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Required for prize payouts. Enable and fund PayMongo Wallet/Disbursements first.
PAYMONGO_WALLET_ACCOUNT_NUMBER=""
PAYMONGO_WALLET_ACCOUNT_NAME=""
