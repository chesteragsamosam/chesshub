{
	"name": "chesshub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate-paymongo": "node --env-file=.env scripts/migrate-paymongo.mjs",
		"db:migrate-modality": "node --env-file=.env scripts/migrate-tournament-modality.mjs",
		"db:migrate-arena-password": "node --env-file=.env scripts/migrate-lichess-arena-password.mjs",
		"db:migrate-social-facebook": "node --env-file=.env scripts/migrate-social-facebook.mjs",
		"db:migrate-facebook-deletion": "node --env-file=.env scripts/migrate-facebook-data-deletion.mjs",
		"db:migrate-chess-account-fide": "node --env-file=.env scripts/migrate-chess-account-fide.mjs",
		"db:migrate-chess-account-ratings": "node --env-file=.env scripts/migrate-chess-account-ratings.mjs",
		"db:migrate-tournament-clock": "node --env-file=.env scripts/migrate-tournament-clock.mjs",
		"db:migrate-tournament-sponsors": "node --env-file=.env scripts/migrate-tournament-sponsors.mjs",
		"ratings:refresh": "node --env-file=.env scripts/refresh-ratings.mjs",
		"db:seed": "node --env-file=.env scripts/seed-players.mjs",
		"auth:schema": "better-auth generate --config src/lib/server/auth.js --output src/lib/server/db/auth.schema.js --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"better-auth": "~1.4.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mysql2": "^3.22.4",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sass": "^1.101.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"sharp": "^0.35.3"
	}
}
